# Copiá este archivo a server/.env y completalo. NUNCA subas .env al repo.

# Access Token de Mercado Pago (Tus integraciones > Credenciales).
# Para probar usá el de PRUEBA (empieza con TEST-); para cobrar de verdad, el de PRODUCCIÓN (APP_USR-).
# Sin esto, /api/checkout responde 503 "pagos_no_configurados".
MP_ACCESS_TOKEN=

# Clave secreta del webhook (Tus integraciones > Webhooks > Configurar notificaciones).
# Si está vacía, el webhook NO verifica la firma (solo aceptable en desarrollo).
MP_WEBHOOK_SECRET=

# URL pública del sitio, sin barra final. Se usa para los back_urls y el webhook.
# Local: http://localhost:3000. Para probar el flujo completo, la URL https de ngrok.
PUBLIC_URL=http://localhost:3000

PORT=3000

# Interfaz donde escucha. 127.0.0.1 = solo esta máquina; 0.0.0.0 en el servidor detrás de Caddy/Docker.
HOST=127.0.0.1

# Orígenes que pueden llamar a la API desde otro puerto (Live Server). Separados por coma.
# PUBLIC_URL se agrega solo.
ALLOWED_ORIGINS=http://localhost:5502,http://127.0.0.1:5502

# Detrás de un proxy (Caddy) poné 1 para que el rate limit use la IP real del cliente.
# TRUST_PROXY=1
